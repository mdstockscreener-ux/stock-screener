# Supabase project that hosts the market-data tables written by the
# stock-screener-data-collector service. Used by the Bottom-Out Scanner.
#
# Copy to .env.local and fill in from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service-role key for server-side admin writes only (NEVER expose to the
# browser or prefix with NEXT_PUBLIC_). Used by /admin's sync actions and
# by the public read routes' NSE-fallback-on-miss path.
# Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Shared password gating the /admin dashboard's sync actions. Choose a strong value.
ADMIN_PASSWORD=<choose-a-strong-password>

# Random secret used to sign the admin session cookie (HMAC key, unrelated
# to the password above so rotating one doesn't require touching the
# other). Generate with: `openssl rand -hex 32` or equivalent.
ADMIN_SESSION_SECRET=<random-32+-byte-hex-string>

# BharatStock API (https://bharatstockapi.com) — fundamentals, technical
# indicators, corporate actions, deals & insider trades for NSE/BSE stocks.
# Server-only: never prefix with NEXT_PUBLIC_ (see lib/bharatstock.ts).
# Get a key from the BharatStock dashboard.
BHARATSTOCK_API_KEY=<bsk_live_...>

# Optional, and not tied to one AI vendor (see lib/ai/index.ts). Enables
# sentiment/driver classification on the Stock Analysis news panel. Without
# AI_API_KEY, the panel still shows raw news and disclosed events — just
# without the AI read. Server-only.
#
# AI_PROVIDER   'anthropic' | 'openai'   (default: 'anthropic')
# AI_API_KEY    the key for that provider
# AI_MODEL      provider-specific model id — defaults to claude-haiku-4-5
#               (anthropic) or gpt-4o-mini (openai): cheap, low-latency,
#               since this runs on every symbol lookup
# AI_BASE_URL   override the endpoint — with AI_PROVIDER=openai this
#               reaches ANY OpenAI-compatible service: Groq, Together,
#               DeepSeek, Mistral, xAI, OpenRouter, Ollama, LM Studio, ...
#
# Example — Anthropic (get a key at https://console.anthropic.com):
# AI_PROVIDER=anthropic
# AI_API_KEY=<sk-ant-...>
# AI_MODEL=claude-haiku-4-5
#
# Example — OpenAI (get a key at https://platform.openai.com):
# AI_PROVIDER=openai
# AI_API_KEY=<sk-...>
# AI_MODEL=gpt-4o-mini
#
# Example — any OpenAI-compatible provider, e.g. Groq (free tier, no
# billing required to start — check console.groq.com/docs/models for the
# current model catalog, it changes over time; must support tool/function
# calling, e.g. openai/gpt-oss-20b):
# AI_PROVIDER=openai
# AI_API_KEY=<gsk_...>
# AI_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=anthropic
AI_API_KEY=<your-key>
AI_MODEL=claude-haiku-4-5
# AI_BASE_URL=
