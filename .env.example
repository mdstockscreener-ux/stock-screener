# Supabase project that hosts the market-data tables written by the
# stock-screener-data-collector service. Used by the Bottom-Out Scanner.
#
# Copy to .env.local and fill in from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service-role key for server-side admin writes only (NEVER expose to the
# browser or prefix with NEXT_PUBLIC_). Used by /admin's sync actions and
# by the public read routes' NSE-fallback-on-miss path.
# Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Shared password gating the /admin dashboard's sync actions. Choose a strong value.
ADMIN_PASSWORD=<choose-a-strong-password>

# Random secret used to sign the admin session cookie (HMAC key, unrelated
# to the password above so rotating one doesn't require touching the
# other). Generate with: `openssl rand -hex 32` or equivalent.
ADMIN_SESSION_SECRET=<random-32+-byte-hex-string>
